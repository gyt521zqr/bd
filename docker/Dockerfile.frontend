# ============================================================================
# Magao Platform - Frontend 多阶段构建 Dockerfile
# ============================================================================
# Stage 1: Node 18 编译构建
# Stage 2: Nginx Alpine 静态资源服务
# ============================================================================

# ---------------------------------------------------------------------------
# Stage 1: 构建阶段 - Node 18 + npm
# ---------------------------------------------------------------------------
FROM node:18-alpine AS builder

WORKDIR /build

# 先复制 package.json 和 lock 文件，利用 Docker 缓存层加速依赖安装
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --registry=https://registry.npmmirror.com

# 复制前端源代码
COPY frontend/ .

# 设置构建参数
ARG VITE_API_BASE_URL=/api
ARG VITE_APP_TITLE=Magao Platform

# 构建生产版本
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_APP_TITLE=${VITE_APP_TITLE}
RUN npm run build

# 验证构建产物
RUN ls -la dist/ && echo "Build completed successfully"

# ---------------------------------------------------------------------------
# Stage 2: 运行阶段 - Nginx Alpine
# ---------------------------------------------------------------------------
FROM nginx:alpine

LABEL maintainer="Magao Platform Team"
LABEL description="Magao Platform Frontend Service"

# 安装必要工具
RUN apk add --no-cache tzdata \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && apk del tzdata

# 删除默认 Nginx 配置
RUN rm -rf /usr/share/nginx/html/*

# 从构建阶段复制前端产物
COPY --from=builder /build/dist /usr/share/nginx/html

# 复制 Nginx 配置（如果存在自定义配置）
# 注意：生产环境通过 docker-compose 挂载配置覆盖
COPY docker/nginx/conf.d/frontend.conf /etc/nginx/conf.d/default.conf

# 创建必要的缓存目录
RUN mkdir -p /var/cache/nginx/client_temp \
    && mkdir -p /var/cache/nginx/proxy_temp \
    && chown -R nginx:nginx /var/cache/nginx

# 暴露端口
EXPOSE 80

# 健康检查
HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=10s \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
