# ============================================================================
# Magao Platform - Docker Compose 环境变量配置模板
# 使用方法：复制本文件为 .env 并填写实际值
#   cp .env.example .env
# 然后再执行：docker compose up -d
# ============================================================================

# ============================================================================
# MySQL 8.0 - 主数据库
# ============================================================================
MYSQL_PORT=3306
# 必填：MySQL root 密码（请改为强密码）
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql
MYSQL_DATABASE=magao_platform

# ============================================================================
# Redis 7 - 缓存
# ============================================================================
REDIS_PORT=6379
# 必填：Redis 密码（请改为强密码）
REDIS_PASSWORD=CHANGE_ME_redis

# ============================================================================
# RabbitMQ 3.12 - 消息队列
# ============================================================================
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=admin
# 必填：RabbitMQ 密码（请改为强密码）
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq
RABBITMQ_VHOST=magao

# ============================================================================
# JWT 签名密钥（必填，生产缺失时后端启动失败）
# 生成方式：openssl rand -hex 48   （得到 96 位十六进制字符串）
# 注意：更换此值会使所有已登录用户的 Token 失效，需重新登录。
# ============================================================================
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_48_at_least_64_chars

# ============================================================================
# 火山引擎 TOS 对象存储（文件上传，必填，否则作品/封面/头像上传不可用）
# 获取方式：火山引擎控制台 -> 对象存储 TOS -> 访问密钥
# ============================================================================
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_ACCESS_KEY=CHANGE_ME_tos_ak
TOS_SECRET_KEY=CHANGE_ME_tos_sk
TOS_BUCKET=magao
# 可选：CDN 加速域名（如 https://cdn.example.com）
TOS_PUBLIC_DOMAIN=

# ============================================================================
# 火山引擎 VOD 视频点播（课程视频，必填，否则视频播放不可用）
# 获取方式：火山引擎控制台 -> 视频点播 VOD -> 访问密钥
# ============================================================================
VOD_ACCESS_KEY=CHANGE_ME_vod_ak
VOD_SECRET_KEY=CHANGE_ME_vod_sk
VOD_REGION=cn-north-1
VOD_PLAY_DOMAIN=
VOD_SPACE_NAME=magao-video

# ============================================================================
# Judge0 / judge0 代码评测沙箱（3 实例，Python/C++/GoC 判题）
# ============================================================================
JUDGE0_PORT_1=2358
JUDGE0_PORT_2=2359
JUDGE0_PORT_3=2360

# ============================================================================
# 后端 / Nginx 端口
# ============================================================================
BACKEND_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================================================
# MinIO 对象存储（可选：仅在放弃 TOS、改回自建 MinIO 时需要）
# 当前默认走火山引擎 TOS，无需配置；如需切回，请取消 docker-compose.yml 中 minio 段注释
# ============================================================================
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=CHANGE_ME_minio
