-- ============================================================================
-- Magao Platform - 魔高少儿编程教育平台 数据库初始化脚本
-- ============================================================================
-- 数据库版本: MySQL 8.0+
-- 字符集: utf8mb4
-- 排序规则: utf8mb4_unicode_ci
-- 引擎: InnoDB
-- 总计: 48张表
-- 创建日期: 2026-06-17
-- 说明: 本脚本包含完整的建表语句、索引定义及初始化测试数据
-- ============================================================================

-- 创建数据库
DROP DATABASE IF EXISTS `magao_platform`;
CREATE DATABASE `magao_platform` DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE `magao_platform`;

-- ============================================================================
-- [模块一] 用户中心 (6张表)
-- 表清单: sys_user, sys_role, sys_user_role, sys_permission,
--          sys_role_permission, sys_user_login_log
-- ============================================================================

-- ----------------------------
-- 1. sys_user 用户表
-- ----------------------------
DROP TABLE IF EXISTS `sys_user`;
CREATE TABLE `sys_user` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '用户ID',
    `username` VARCHAR(50) NOT NULL COMMENT '用户名',
    `password` VARCHAR(255) NOT NULL COMMENT '密码(BCrypt加密)',
    `nickname` VARCHAR(100) DEFAULT NULL COMMENT '昵称',
    `avatar` VARCHAR(500) DEFAULT NULL COMMENT '头像URL',
    `email` VARCHAR(100) DEFAULT NULL COMMENT '邮箱',
    `phone` VARCHAR(20) DEFAULT NULL COMMENT '手机号',
    `real_name` VARCHAR(50) DEFAULT NULL COMMENT '真实姓名',
    `role_type` VARCHAR(20) NOT NULL DEFAULT 'STUDENT' COMMENT '角色类型: STUDENT-学生, TEACHER-教师, OPERATOR-运营, ADMIN-管理员',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-禁用, 1-启用',
    `last_login_ip` VARCHAR(50) DEFAULT NULL COMMENT '最后登录IP',
    `last_login_time` DATETIME DEFAULT NULL COMMENT '最后登录时间',
    `wechat_open_id` VARCHAR(100) DEFAULT NULL COMMENT '微信OpenID',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_username` (`username`),
    UNIQUE KEY `uk_phone` (`phone`),
    UNIQUE KEY `uk_email` (`email`),
    KEY `idx_role_type` (`role_type`),
    KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户表';

-- ----------------------------
-- 2. sys_role 角色表
-- ----------------------------
DROP TABLE IF EXISTS `sys_role`;
CREATE TABLE `sys_role` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '角色ID',
    `role_name` VARCHAR(50) NOT NULL COMMENT '角色名称',
    `role_code` VARCHAR(50) NOT NULL COMMENT '角色编码(唯一)',
    `description` VARCHAR(200) DEFAULT NULL COMMENT '角色描述',
    `sort_order` INT NOT NULL DEFAULT 0 COMMENT '排序号',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-禁用, 1-启用',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_role_code` (`role_code`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='角色表';

-- ----------------------------
-- 3. sys_user_role 用户角色关联表
-- ----------------------------
DROP TABLE IF EXISTS `sys_user_role`;
CREATE TABLE `sys_user_role` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '主键ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `role_id` BIGINT NOT NULL COMMENT '角色ID',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_user_role` (`user_id`, `role_id`),
    KEY `idx_role_id` (`role_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户角色关联表';

-- ----------------------------
-- 4. sys_permission 权限表
-- ----------------------------
DROP TABLE IF EXISTS `sys_permission`;
CREATE TABLE `sys_permission` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '权限ID',
    `parent_id` BIGINT NOT NULL DEFAULT 0 COMMENT '父级ID, 0表示顶级',
    `permission_name` VARCHAR(50) NOT NULL COMMENT '权限名称',
    `permission_type` TINYINT NOT NULL COMMENT '类型: 1-菜单, 2-按钮, 3-接口',
    `permission_code` VARCHAR(100) DEFAULT NULL COMMENT '权限编码',
    `path` VARCHAR(200) DEFAULT NULL COMMENT '路由路径',
    `icon` VARCHAR(100) DEFAULT NULL COMMENT '图标',
    `component` VARCHAR(200) DEFAULT NULL COMMENT '组件路径',
    `sort_order` INT NOT NULL DEFAULT 0 COMMENT '排序号',
    `visible` TINYINT NOT NULL DEFAULT 1 COMMENT '是否可见: 0-隐藏, 1-显示',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-禁用, 1-启用',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_parent_id` (`parent_id`),
    KEY `idx_permission_type` (`permission_type`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='权限表';

-- ----------------------------
-- 5. sys_role_permission 角色权限关联表
-- ----------------------------
DROP TABLE IF EXISTS `sys_role_permission`;
CREATE TABLE `sys_role_permission` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '主键ID',
    `role_id` BIGINT NOT NULL COMMENT '角色ID',
    `permission_id` BIGINT NOT NULL COMMENT '权限ID',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_role_permission` (`role_id`, `permission_id`),
    KEY `idx_permission_id` (`permission_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='角色权限关联表';

-- ----------------------------
-- 6. sys_user_login_log 登录日志表
-- ----------------------------
DROP TABLE IF EXISTS `sys_user_login_log`;
CREATE TABLE `sys_user_login_log` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '日志ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `username` VARCHAR(50) NOT NULL COMMENT '登录用户名',
    `login_ip` VARCHAR(50) DEFAULT NULL COMMENT '登录IP地址',
    `login_location` VARCHAR(100) DEFAULT NULL COMMENT '登录地点',
    `device_type` VARCHAR(20) DEFAULT NULL COMMENT '设备类型: PC, MOBILE, TABLET',
    `browser` VARCHAR(50) DEFAULT NULL COMMENT '浏览器',
    `os` VARCHAR(50) DEFAULT NULL COMMENT '操作系统',
    `login_result` TINYINT NOT NULL COMMENT '登录结果: 0-失败, 1-成功',
    `fail_reason` VARCHAR(200) DEFAULT NULL COMMENT '失败原因',
    `login_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '登录时间',
    PRIMARY KEY (`id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_login_time` (`login_time`),
    KEY `idx_login_result` (`login_result`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='登录日志表';


-- ============================================================================
-- [模块二] 课程模块 (7张表)
-- 表清单: course_info, course_chapter, course_video, course_purchase,
--          video_comment, video_progress, video_danmaku
-- ============================================================================

-- ----------------------------
-- 7. course_info 课程表
-- ----------------------------
DROP TABLE IF EXISTS `course_info`;
CREATE TABLE `course_info` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '课程ID',
    `title` VARCHAR(200) NOT NULL COMMENT '课程标题',
    `cover` VARCHAR(500) DEFAULT NULL COMMENT '课程封面URL',
    `description` TEXT DEFAULT NULL COMMENT '课程描述',
    `teacher_id` BIGINT NOT NULL COMMENT '授课教师ID',
    `language_type` VARCHAR(20) NOT NULL COMMENT '编程语言: SCRATCH_JR, SCRATCH3, PYTHON, CPP, GOC',
    `difficulty` TINYINT NOT NULL DEFAULT 1 COMMENT '难度等级: 1-入门, 2-基础, 3-进阶, 4-高级',
    `min_age` INT DEFAULT NULL COMMENT '适合最小年龄',
    `max_age` INT DEFAULT NULL COMMENT '适合最大年龄',
    `price` DECIMAL(10,2) NOT NULL DEFAULT 0.00 COMMENT '售价(元)',
    `original_price` DECIMAL(10,2) DEFAULT NULL COMMENT '原价(元)',
    `status` TINYINT NOT NULL DEFAULT 0 COMMENT '状态: 0-草稿, 1-已发布, 2-已下架',
    `trial_chapter_count` INT NOT NULL DEFAULT 0 COMMENT '试看章节数',
    `total_chapters` INT NOT NULL DEFAULT 0 COMMENT '总章节数',
    `total_duration` INT NOT NULL DEFAULT 0 COMMENT '总时长(秒)',
    `student_count` INT NOT NULL DEFAULT 0 COMMENT '学习人数',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_teacher_id` (`teacher_id`),
    KEY `idx_language_type` (`language_type`),
    KEY `idx_status` (`status`),
    KEY `idx_difficulty` (`difficulty`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='课程表';

-- ----------------------------
-- 8. course_chapter 章节表
-- ----------------------------
DROP TABLE IF EXISTS `course_chapter`;
CREATE TABLE `course_chapter` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '章节ID',
    `course_id` BIGINT NOT NULL COMMENT '课程ID',
    `parent_id` BIGINT NOT NULL DEFAULT 0 COMMENT '父级章节ID, 0表示顶级',
    `title` VARCHAR(200) NOT NULL COMMENT '章节标题',
    `description` VARCHAR(500) DEFAULT NULL COMMENT '章节描述',
    `sort_order` INT NOT NULL DEFAULT 0 COMMENT '排序号',
    `is_trial` TINYINT NOT NULL DEFAULT 0 COMMENT '是否试看: 0-否, 1-是',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_course_id` (`course_id`),
    KEY `idx_parent_id` (`parent_id`),
    KEY `idx_course_parent` (`course_id`, `parent_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='章节表';

-- ----------------------------
-- 9. course_video 视频表
-- ----------------------------
DROP TABLE IF EXISTS `course_video`;
CREATE TABLE `course_video` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '视频ID',
    `chapter_id` BIGINT NOT NULL COMMENT '章节ID',
    `course_id` BIGINT NOT NULL COMMENT '课程ID',
    `title` VARCHAR(200) NOT NULL COMMENT '视频标题',
    `original_url` VARCHAR(1000) DEFAULT NULL COMMENT '原始视频URL',
    `hls_playlist_url` VARCHAR(1000) DEFAULT NULL COMMENT 'HLS播放列表URL',
    `encrypt_key` VARCHAR(255) DEFAULT NULL COMMENT '加密密钥',
    `duration` INT NOT NULL DEFAULT 0 COMMENT '视频时长(秒)',
    `cover` VARCHAR(500) DEFAULT NULL COMMENT '视频封面URL',
    `transcode_status` TINYINT NOT NULL DEFAULT 0 COMMENT '转码状态: 0-待转码, 1-转码中, 2-已完成, 3-失败',
    `sort_order` INT NOT NULL DEFAULT 0 COMMENT '排序号',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_chapter_id` (`chapter_id`),
    KEY `idx_course_id` (`course_id`),
    KEY `idx_transcode_status` (`transcode_status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='视频表';

-- ----------------------------
-- 10. course_purchase 购买记录表
-- ----------------------------
DROP TABLE IF EXISTS `course_purchase`;
CREATE TABLE `course_purchase` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '购买记录ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `course_id` BIGINT NOT NULL COMMENT '课程ID',
    `purchase_type` TINYINT NOT NULL DEFAULT 1 COMMENT '购买类型: 1-单独购买, 2-会员开通, 3-团购, 4-兑换',
    `order_id` BIGINT DEFAULT NULL COMMENT '关联订单ID',
    `price` DECIMAL(10,2) NOT NULL COMMENT '购买价格',
    `expire_time` DATETIME DEFAULT NULL COMMENT '过期时间(会员/团购有效)',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_user_course` (`user_id`, `course_id`),
    KEY `idx_course_id` (`course_id`),
    KEY `idx_order_id` (`order_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='课程购买记录表';

-- ----------------------------
-- 11. video_comment 视频评论表
-- ----------------------------
DROP TABLE IF EXISTS `video_comment`;
CREATE TABLE `video_comment` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '评论ID',
    `video_id` BIGINT NOT NULL COMMENT '视频ID',
    `user_id` BIGINT NOT NULL COMMENT '评论用户ID',
    `parent_id` BIGINT NOT NULL DEFAULT 0 COMMENT '父评论ID, 0表示顶级评论',
    `content` TEXT NOT NULL COMMENT '评论内容',
    `like_count` INT NOT NULL DEFAULT 0 COMMENT '点赞数',
    `reply_count` INT NOT NULL DEFAULT 0 COMMENT '回复数',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_video_id` (`video_id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_parent_id` (`parent_id`),
    KEY `idx_video_create` (`video_id`, `create_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='视频评论表';

-- ----------------------------
-- 12. video_progress 学习进度表
-- ----------------------------
DROP TABLE IF EXISTS `video_progress`;
CREATE TABLE `video_progress` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '进度ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `video_id` BIGINT NOT NULL COMMENT '视频ID',
    `course_id` BIGINT NOT NULL COMMENT '课程ID',
    `watched_duration` INT NOT NULL DEFAULT 0 COMMENT '已观看时长(秒)',
    `total_duration` INT NOT NULL DEFAULT 0 COMMENT '视频总时长(秒)',
    `progress_percent` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT '进度百分比',
    `is_completed` TINYINT NOT NULL DEFAULT 0 COMMENT '是否完成: 0-未完成, 1-已完成',
    `last_watch_time` DATETIME DEFAULT NULL COMMENT '最后观看时间',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_user_video` (`user_id`, `video_id`),
    KEY `idx_course_id` (`course_id`),
    KEY `idx_user_course` (`user_id`, `course_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='视频学习进度表';

-- ----------------------------
-- 13. video_danmaku 弹幕记录表
-- ----------------------------
DROP TABLE IF EXISTS `video_danmaku`;
CREATE TABLE `video_danmaku` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '弹幕ID',
    `video_id` BIGINT NOT NULL COMMENT '视频ID',
    `user_id` BIGINT NOT NULL COMMENT '发送用户ID',
    `content` VARCHAR(200) NOT NULL COMMENT '弹幕内容',
    `time_position` DECIMAL(8,3) NOT NULL COMMENT '弹幕出现时间位置(秒)',
    `color` VARCHAR(20) DEFAULT '#FFFFFF' COMMENT '弹幕颜色',
    `font_size` INT NOT NULL DEFAULT 16 COMMENT '字号',
    `mode` TINYINT NOT NULL DEFAULT 1 COMMENT '弹幕模式: 1-滚动, 2-顶部固定, 3-底部固定',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    KEY `idx_video_id` (`video_id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_video_time` (`video_id`, `time_position`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='弹幕记录表';


-- ============================================================================
-- [模块三] 编程练习模块 (6张表)
-- 表清单: practice_question, test_case, practice_record, practice_draft,
--          scratch_project, question_recommend
-- ============================================================================

-- ----------------------------
-- 14. practice_question 练习题目表
-- ----------------------------
DROP TABLE IF EXISTS `practice_question`;
CREATE TABLE `practice_question` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '题目ID',
    `title` VARCHAR(200) NOT NULL COMMENT '题目标题',
    `description` TEXT NOT NULL COMMENT '题目描述',
    `language` VARCHAR(20) NOT NULL COMMENT '编程语言: SCRATCH_JR, SCRATCH3, PYTHON, CPP, GOC',
    `difficulty` TINYINT NOT NULL DEFAULT 1 COMMENT '难度等级: 1-入门, 2-基础, 3-进阶, 4-高级',
    `time_limit` INT NOT NULL DEFAULT 1000 COMMENT '时间限制(毫秒)',
    `memory_limit` INT NOT NULL DEFAULT 256 COMMENT '内存限制(MB)',
    `template_code` TEXT DEFAULT NULL COMMENT '模板代码',
    `tags` VARCHAR(500) DEFAULT NULL COMMENT '标签(逗号分隔)',
    `submit_count` INT NOT NULL DEFAULT 0 COMMENT '提交次数',
    `accept_count` INT NOT NULL DEFAULT 0 COMMENT '通过次数',
    `accept_rate` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT '通过率(%)',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-禁用, 1-启用',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_language` (`language`),
    KEY `idx_difficulty` (`difficulty`),
    KEY `idx_status` (`status`),
    KEY `idx_language_difficulty` (`language`, `difficulty`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='练习题目表';

-- ----------------------------
-- 15. test_case 测试用例表
-- ----------------------------
DROP TABLE IF EXISTS `test_case`;
CREATE TABLE `test_case` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '测试用例ID',
    `question_id` BIGINT NOT NULL COMMENT '题目ID',
    `input_data` TEXT NOT NULL COMMENT '输入数据',
    `expected_output` TEXT NOT NULL COMMENT '期望输出',
    `is_sample` TINYINT NOT NULL DEFAULT 0 COMMENT '是否样例: 0-否, 1-是',
    `score` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT '分值',
    `sort_order` INT NOT NULL DEFAULT 0 COMMENT '排序号',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_question_id` (`question_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='测试用例表';

-- ----------------------------
-- 16. practice_record 提交记录表
-- ----------------------------
DROP TABLE IF EXISTS `practice_record`;
CREATE TABLE `practice_record` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '提交记录ID',
    `question_id` BIGINT NOT NULL COMMENT '题目ID',
    `user_id` BIGINT NOT NULL COMMENT '提交用户ID',
    `code` TEXT DEFAULT NULL COMMENT '提交代码',
    `scratch_json` MEDIUMTEXT DEFAULT NULL COMMENT 'Scratch项目JSON',
    `language` VARCHAR(20) NOT NULL COMMENT '编程语言',
    `judge_status` VARCHAR(20) NOT NULL DEFAULT 'PENDING' COMMENT '判题状态: PENDING-等待, JUDGING-判题中, AC-通过, WA-答案错误, TLE-超时, MLE-超内存, CE-编译错误, RE-运行错误',
    `score` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT '得分',
    `time_cost` INT NOT NULL DEFAULT 0 COMMENT '耗时(毫秒)',
    `memory_cost` INT NOT NULL DEFAULT 0 COMMENT '内存消耗(KB)',
    `error_message` TEXT DEFAULT NULL COMMENT '错误信息',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_question_id` (`question_id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_judge_status` (`judge_status`),
    KEY `idx_user_question` (`user_id`, `question_id`),
    KEY `idx_create_time` (`create_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='练习提交记录表';

-- ----------------------------
-- 17. practice_draft 草稿表
-- ----------------------------
DROP TABLE IF EXISTS `practice_draft`;
CREATE TABLE `practice_draft` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '草稿ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `question_id` BIGINT NOT NULL COMMENT '题目ID',
    `code` TEXT DEFAULT NULL COMMENT '代码草稿',
    `scratch_json` MEDIUMTEXT DEFAULT NULL COMMENT 'Scratch项目草稿JSON',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_user_question` (`user_id`, `question_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='练习草稿表';

-- ----------------------------
-- 18. scratch_project Scratch作品表
-- ----------------------------
DROP TABLE IF EXISTS `scratch_project`;
CREATE TABLE `scratch_project` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '作品ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `title` VARCHAR(200) NOT NULL COMMENT '作品标题',
    `description` TEXT DEFAULT NULL COMMENT '作品描述',
    `project_json` MEDIUMTEXT NOT NULL COMMENT 'Scratch项目JSON数据',
    `thumbnail` VARCHAR(500) DEFAULT NULL COMMENT '缩略图URL',
    `is_public` TINYINT NOT NULL DEFAULT 0 COMMENT '是否公开: 0-私有, 1-公开',
    `view_count` INT NOT NULL DEFAULT 0 COMMENT '浏览次数',
    `like_count` INT NOT NULL DEFAULT 0 COMMENT '点赞次数',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_is_public` (`is_public`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Scratch作品表';

-- ----------------------------
-- 19. question_recommend 题目推荐记录表
-- ----------------------------
DROP TABLE IF EXISTS `question_recommend`;
CREATE TABLE `question_recommend` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '推荐ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `question_id` BIGINT NOT NULL COMMENT '题目ID',
    `recommend_reason` VARCHAR(200) DEFAULT NULL COMMENT '推荐理由',
    `score` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT '推荐分数',
    `is_clicked` TINYINT NOT NULL DEFAULT 0 COMMENT '是否点击: 0-否, 1-是',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_question_id` (`question_id`),
    KEY `idx_user_score` (`user_id`, `score`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='题目推荐记录表';


-- ============================================================================
-- [模块四] 在线考试模块 (7张表)
-- 表清单: exam_info, exam_paper, exam_paper_question, exam_record,
--          exam_answer, exam_violation_log, exam_snapshot
-- ============================================================================

-- ----------------------------
-- 20. exam_info 考试表
-- ----------------------------
DROP TABLE IF EXISTS `exam_info`;
CREATE TABLE `exam_info` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '考试ID',
    `title` VARCHAR(200) NOT NULL COMMENT '考试标题',
    `description` TEXT DEFAULT NULL COMMENT '考试描述',
    `exam_type` TINYINT NOT NULL DEFAULT 1 COMMENT '考试类型: 1-随堂测验, 2-单元测试, 3-期中考试, 4-期末考试',
    `language` VARCHAR(20) NOT NULL COMMENT '编程语言',
    `course_id` BIGINT DEFAULT NULL COMMENT '关联课程ID',
    `teacher_id` BIGINT NOT NULL COMMENT '出题教师ID',
    `start_time` DATETIME NOT NULL COMMENT '考试开始时间',
    `end_time` DATETIME NOT NULL COMMENT '考试结束时间',
    `duration` INT NOT NULL COMMENT '考试时长(分钟)',
    `total_score` DECIMAL(6,2) NOT NULL DEFAULT 100.00 COMMENT '总分',
    `pass_score` DECIMAL(6,2) NOT NULL DEFAULT 60.00 COMMENT '及格分',
    `max_participants` INT NOT NULL DEFAULT 1000 COMMENT '最大参与人数',
    `current_participants` INT NOT NULL DEFAULT 0 COMMENT '当前参与人数',
    `anti_cheat_level` TINYINT NOT NULL DEFAULT 1 COMMENT '防作弊等级: 0-关闭, 1-基础, 2-严格, 3-极严',
    `max_tab_switch` INT NOT NULL DEFAULT 3 COMMENT '最大切屏次数',
    `status` TINYINT NOT NULL DEFAULT 0 COMMENT '状态: 0-草稿, 1-已发布, 2-进行中, 3-已结束',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_course_id` (`course_id`),
    KEY `idx_teacher_id` (`teacher_id`),
    KEY `idx_status` (`status`),
    KEY `idx_start_time` (`start_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='考试表';

-- ----------------------------
-- 21. exam_paper 试卷表
-- ----------------------------
DROP TABLE IF EXISTS `exam_paper`;
CREATE TABLE `exam_paper` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '试卷ID',
    `exam_id` BIGINT NOT NULL COMMENT '考试ID',
    `paper_name` VARCHAR(200) NOT NULL COMMENT '试卷名称',
    `is_random` TINYINT NOT NULL DEFAULT 0 COMMENT '是否随机出题: 0-固定, 1-随机',
    `random_seed` INT DEFAULT NULL COMMENT '随机种子',
    `total_score` DECIMAL(6,2) NOT NULL DEFAULT 100.00 COMMENT '总分',
    `question_count` INT NOT NULL DEFAULT 0 COMMENT '题目数量',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_exam_id` (`exam_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='试卷表';

-- ----------------------------
-- 22. exam_paper_question 试卷题目关联表
-- ----------------------------
DROP TABLE IF EXISTS `exam_paper_question`;
CREATE TABLE `exam_paper_question` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '关联ID',
    `paper_id` BIGINT NOT NULL COMMENT '试卷ID',
    `question_id` BIGINT NOT NULL COMMENT '题目ID',
    `question_type` VARCHAR(20) NOT NULL COMMENT '题型: CHOICE-选择题, FILL-填空题, CODE-编程题, JUDGE-判断题, SCRATCH-Scratch题',
    `score` DECIMAL(5,2) NOT NULL COMMENT '分值',
    `sort_order` INT NOT NULL DEFAULT 0 COMMENT '排序号',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    KEY `idx_paper_id` (`paper_id`),
    KEY `idx_question_id` (`question_id`),
    KEY `idx_paper_sort` (`paper_id`, `sort_order`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='试卷题目关联表';

-- ----------------------------
-- 23. exam_record 考试记录表(高频表)
-- ----------------------------
DROP TABLE IF EXISTS `exam_record`;
CREATE TABLE `exam_record` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '考试记录ID',
    `exam_id` BIGINT NOT NULL COMMENT '考试ID',
    `paper_id` BIGINT NOT NULL COMMENT '试卷ID',
    `user_id` BIGINT NOT NULL COMMENT '考生ID',
    `score` DECIMAL(6,2) NOT NULL DEFAULT 0.00 COMMENT '得分',
    `status` VARCHAR(20) NOT NULL DEFAULT 'NOT_STARTED' COMMENT '状态: NOT_STARTED-未开始, IN_PROGRESS-进行中, SUBMITTED-已提交, GRADING-阅卷中, GRADED-已阅卷, ABNORMAL-异常',
    `start_time` DATETIME DEFAULT NULL COMMENT '开始答题时间',
    `submit_time` DATETIME DEFAULT NULL COMMENT '提交时间',
    `tab_switch_count` INT NOT NULL DEFAULT 0 COMMENT '切屏次数',
    `violation_count` INT NOT NULL DEFAULT 0 COMMENT '违规次数',
    `snapshot_version` INT NOT NULL DEFAULT 0 COMMENT '快照版本号',
    `client_info` VARCHAR(500) DEFAULT NULL COMMENT '客户端信息',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_exam_user` (`exam_id`, `user_id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_status` (`status`),
    KEY `idx_paper_id` (`paper_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='考试记录表';

-- ----------------------------
-- 24. exam_answer 考试作答表
-- ----------------------------
DROP TABLE IF EXISTS `exam_answer`;
CREATE TABLE `exam_answer` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '作答ID',
    `record_id` BIGINT NOT NULL COMMENT '考试记录ID',
    `question_id` BIGINT NOT NULL COMMENT '题目ID',
    `user_id` BIGINT NOT NULL COMMENT '考生ID',
    `answer_content` TEXT DEFAULT NULL COMMENT '答案内容(选择/填空/判断)',
    `code` TEXT DEFAULT NULL COMMENT '编程代码',
    `scratch_json` MEDIUMTEXT DEFAULT NULL COMMENT 'Scratch项目JSON',
    `score` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT '得分',
    `judge_status` VARCHAR(20) DEFAULT NULL COMMENT '判题状态: PENDING, JUDGING, AC, WA, TLE, MLE, CE, RE',
    `time_cost` INT NOT NULL DEFAULT 0 COMMENT '答题耗时(秒)',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_record_question` (`record_id`, `question_id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_question_id` (`question_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='考试作答表';

-- ----------------------------
-- 25. exam_violation_log 违规日志表
-- ----------------------------
DROP TABLE IF EXISTS `exam_violation_log`;
CREATE TABLE `exam_violation_log` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '违规日志ID',
    `record_id` BIGINT NOT NULL COMMENT '考试记录ID',
    `exam_id` BIGINT NOT NULL COMMENT '考试ID',
    `user_id` BIGINT NOT NULL COMMENT '考生ID',
    `violation_type` VARCHAR(30) NOT NULL COMMENT '违规类型: TAB_SWITCH-切屏, FULLSCREEN_EXIT-退出全屏, COPY_PASTE-复制粘贴, SUSPICIOUS_BEHAVIOR-可疑行为',
    `description` VARCHAR(500) DEFAULT NULL COMMENT '违规描述',
    `violation_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '违规时间',
    PRIMARY KEY (`id`),
    KEY `idx_record_id` (`record_id`),
    KEY `idx_exam_id` (`exam_id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_violation_time` (`violation_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='考试违规日志表';

-- ----------------------------
-- 26. exam_snapshot 考试快照表
-- ----------------------------
DROP TABLE IF EXISTS `exam_snapshot`;
CREATE TABLE `exam_snapshot` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '快照ID',
    `record_id` BIGINT NOT NULL COMMENT '考试记录ID',
    `exam_id` BIGINT NOT NULL COMMENT '考试ID',
    `user_id` BIGINT NOT NULL COMMENT '考生ID',
    `snapshot_data` JSON DEFAULT NULL COMMENT '快照JSON数据',
    `version` INT NOT NULL DEFAULT 1 COMMENT '版本号',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    KEY `idx_record_id` (`record_id`),
    KEY `idx_exam_id` (`exam_id`),
    KEY `idx_record_version` (`record_id`, `version`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='考试快照表';


-- ============================================================================
-- [模块五] 阅卷模块 (3张表)
-- 表清单: exam_grading_task, exam_grading_detail, exam_grading_review
-- ============================================================================

-- ----------------------------
-- 27. exam_grading_task 阅卷任务表
-- ----------------------------
DROP TABLE IF EXISTS `exam_grading_task`;
CREATE TABLE `exam_grading_task` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '阅卷任务ID',
    `exam_id` BIGINT NOT NULL COMMENT '考试ID',
    `record_id` BIGINT NOT NULL COMMENT '考试记录ID',
    `user_id` BIGINT NOT NULL COMMENT '考生ID',
    `auto_score` DECIMAL(6,2) NOT NULL DEFAULT 0.00 COMMENT '自动评分',
    `teacher_id` BIGINT DEFAULT NULL COMMENT '阅卷教师ID',
    `teacher_score` DECIMAL(6,2) DEFAULT NULL COMMENT '教师评分',
    `review_teacher_id` BIGINT DEFAULT NULL COMMENT '审核教师ID',
    `review_status` VARCHAR(20) NOT NULL DEFAULT 'PENDING' COMMENT '审核状态: PENDING-待审核, AUTO_GRADED-已自动评分, REVIEWING-审核中, REVIEWED-已审核, CONFIRMED-已确认',
    `review_score` DECIMAL(6,2) DEFAULT NULL COMMENT '审核评分',
    `leader_id` BIGINT DEFAULT NULL COMMENT '组长ID',
    `leader_status` VARCHAR(20) DEFAULT NULL COMMENT '组长审核状态',
    `admin_confirm` TINYINT NOT NULL DEFAULT 0 COMMENT '管理员确认: 0-未确认, 1-已确认',
    `final_score` DECIMAL(6,2) DEFAULT NULL COMMENT '最终得分',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_exam_record` (`exam_id`, `record_id`),
    KEY `idx_teacher_id` (`teacher_id`),
    KEY `idx_review_teacher_id` (`review_teacher_id`),
    KEY `idx_review_status` (`review_status`),
    KEY `idx_user_id` (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='阅卷任务表';

-- ----------------------------
-- 28. exam_grading_detail 阅卷明细表
-- ----------------------------
DROP TABLE IF EXISTS `exam_grading_detail`;
CREATE TABLE `exam_grading_detail` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '阅卷明细ID',
    `task_id` BIGINT NOT NULL COMMENT '阅卷任务ID',
    `record_id` BIGINT NOT NULL COMMENT '考试记录ID',
    `question_id` BIGINT NOT NULL COMMENT '题目ID',
    `auto_score` DECIMAL(5,2) NOT NULL DEFAULT 0.00 COMMENT '自动评分',
    `teacher_score` DECIMAL(5,2) DEFAULT NULL COMMENT '教师评分',
    `annotation` VARCHAR(500) DEFAULT NULL COMMENT '批注',
    `is_disputed` TINYINT NOT NULL DEFAULT 0 COMMENT '是否争议: 0-否, 1-是',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_task_id` (`task_id`),
    KEY `idx_record_id` (`record_id`),
    KEY `idx_question_id` (`question_id`),
    UNIQUE KEY `uk_task_question` (`task_id`, `question_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='阅卷明细表';

-- ----------------------------
-- 29. exam_grading_review 审核记录表
-- ----------------------------
DROP TABLE IF EXISTS `exam_grading_review`;
CREATE TABLE `exam_grading_review` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '审核记录ID',
    `task_id` BIGINT NOT NULL COMMENT '阅卷任务ID',
    `reviewer_id` BIGINT NOT NULL COMMENT '审核人ID',
    `review_type` VARCHAR(20) NOT NULL COMMENT '审核类型: TEACHER_REVIEW-教师审核, HEAD_REVIEW-组长审核, ADMIN_CONFIRM-管理员确认',
    `operation` VARCHAR(20) NOT NULL COMMENT '操作: APPROVE-通过, REJECT-驳回, ESCALATE-升级',
    `comment` VARCHAR(500) DEFAULT NULL COMMENT '审核意见',
    `score_after_review` DECIMAL(6,2) DEFAULT NULL COMMENT '审核后分数',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    KEY `idx_task_id` (`task_id`),
    KEY `idx_reviewer_id` (`reviewer_id`),
    KEY `idx_review_type` (`review_type`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='阅卷审核记录表';


-- ============================================================================
-- [模块六] 支付模块 (3张表)
-- 表清单: pay_order, pay_refund, pay_callback_log
-- ============================================================================

-- ----------------------------
-- 30. pay_order 支付订单表
-- ----------------------------
DROP TABLE IF EXISTS `pay_order`;
CREATE TABLE `pay_order` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '订单ID',
    `order_no` VARCHAR(64) NOT NULL COMMENT '订单号',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `business_type` VARCHAR(20) NOT NULL COMMENT '业务类型: COURSE-课程, MEMBERSHIP-会员, GROUP_BUY-团购, POINT_GOODS-积分商品',
    `business_id` BIGINT NOT NULL COMMENT '业务ID',
    `pay_channel` VARCHAR(20) DEFAULT NULL COMMENT '支付渠道: ALIPAY-支付宝, WECHAT-微信, BALANCE-余额',
    `total_amount` DECIMAL(10,2) NOT NULL COMMENT '订单金额',
    `discount_amount` DECIMAL(10,2) NOT NULL DEFAULT 0.00 COMMENT '优惠金额',
    `pay_amount` DECIMAL(10,2) NOT NULL COMMENT '实付金额',
    `status` TINYINT NOT NULL DEFAULT 0 COMMENT '状态: 0-待支付, 1-已支付, 2-已取消, 3-已过期, 4-已退款',
    `trade_no` VARCHAR(128) DEFAULT NULL COMMENT '第三方交易号',
    `pay_time` DATETIME DEFAULT NULL COMMENT '支付时间',
    `expire_time` DATETIME NOT NULL COMMENT '过期时间',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_order_no` (`order_no`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_business` (`business_type`, `business_id`),
    KEY `idx_status` (`status`),
    KEY `idx_pay_time` (`pay_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='支付订单表';

-- ----------------------------
-- 31. pay_refund 退款记录表
-- ----------------------------
DROP TABLE IF EXISTS `pay_refund`;
CREATE TABLE `pay_refund` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '退款ID',
    `refund_no` VARCHAR(64) NOT NULL COMMENT '退款单号',
    `order_id` BIGINT NOT NULL COMMENT '关联订单ID',
    `order_no` VARCHAR(64) NOT NULL COMMENT '关联订单号',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `refund_amount` DECIMAL(10,2) NOT NULL COMMENT '退款金额',
    `reason` VARCHAR(500) DEFAULT NULL COMMENT '退款原因',
    `status` TINYINT NOT NULL DEFAULT 0 COMMENT '状态: 0-申请中, 1-已退款, 2-已拒绝',
    `trade_no` VARCHAR(128) DEFAULT NULL COMMENT '第三方退款交易号',
    `refund_time` DATETIME DEFAULT NULL COMMENT '退款时间',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_refund_no` (`refund_no`),
    KEY `idx_order_id` (`order_id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='退款记录表';

-- ----------------------------
-- 32. pay_callback_log 支付回调日志表
-- ----------------------------
DROP TABLE IF EXISTS `pay_callback_log`;
CREATE TABLE `pay_callback_log` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '日志ID',
    `order_no` VARCHAR(64) NOT NULL COMMENT '关联订单号',
    `pay_channel` VARCHAR(20) NOT NULL COMMENT '支付渠道',
    `callback_type` VARCHAR(20) NOT NULL COMMENT '回调类型: PAY-支付, REFUND-退款',
    `request_body` TEXT DEFAULT NULL COMMENT '请求体',
    `response_body` TEXT DEFAULT NULL COMMENT '响应体',
    `status` TINYINT NOT NULL DEFAULT 0 COMMENT '处理状态: 0-失败, 1-成功',
    `error_message` VARCHAR(500) DEFAULT NULL COMMENT '错误信息',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    KEY `idx_order_no` (`order_no`),
    KEY `idx_pay_channel` (`pay_channel`),
    KEY `idx_create_time` (`create_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='支付回调日志表';


-- ============================================================================
-- [模块七] 成长体系 (7张表)
-- 表清单: user_point, point_log, medal, user_medal, user_level,
--          point_goods, point_exchange
-- ============================================================================

-- ----------------------------
-- 33. user_point 用户积分表
-- ----------------------------
DROP TABLE IF EXISTS `user_point`;
CREATE TABLE `user_point` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '积分ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `total_point` INT NOT NULL DEFAULT 0 COMMENT '总积分',
    `available_point` INT NOT NULL DEFAULT 0 COMMENT '可用积分',
    `frozen_point` INT NOT NULL DEFAULT 0 COMMENT '冻结积分',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_user_id` (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户积分表';

-- ----------------------------
-- 34. point_log 积分日志表
-- ----------------------------
DROP TABLE IF EXISTS `point_log`;
CREATE TABLE `point_log` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '日志ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `change_type` VARCHAR(30) NOT NULL COMMENT '变动类型: SIGN_IN-签到, COURSE_COMPLETE-完成课程, PRACTICE_AC-练习通过, EXAM_PASS-考试通过, EXCHANGE-兑换, REFUND-退还, ADMIN_ADJUST-管理员调整',
    `change_value` INT NOT NULL COMMENT '变动值(正为增加,负为减少)',
    `balance_after` INT NOT NULL COMMENT '变动后余额',
    `description` VARCHAR(200) DEFAULT NULL COMMENT '变动描述',
    `related_id` BIGINT DEFAULT NULL COMMENT '关联业务ID',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_change_type` (`change_type`),
    KEY `idx_create_time` (`create_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='积分变动日志表';

-- ----------------------------
-- 35. medal 勋章表
-- ----------------------------
DROP TABLE IF EXISTS `medal`;
CREATE TABLE `medal` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '勋章ID',
    `medal_name` VARCHAR(50) NOT NULL COMMENT '勋章名称',
    `medal_icon` VARCHAR(500) NOT NULL COMMENT '勋章图标URL',
    `description` VARCHAR(200) DEFAULT NULL COMMENT '勋章描述',
    `condition_type` VARCHAR(30) NOT NULL COMMENT '获取条件类型: COURSE_COUNT-课程数, PRACTICE_COUNT-练习数, EXAM_PASS-考试通过, SIGN_IN_DAYS-签到天数, POINT_TOTAL-总积分',
    `condition_value` INT NOT NULL COMMENT '获取条件值',
    `sort_order` INT NOT NULL DEFAULT 0 COMMENT '排序号',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-禁用, 1-启用',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_condition_type` (`condition_type`),
    KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='勋章表';

-- ----------------------------
-- 36. user_medal 用户勋章表
-- ----------------------------
DROP TABLE IF EXISTS `user_medal`;
CREATE TABLE `user_medal` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '主键ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `medal_id` BIGINT NOT NULL COMMENT '勋章ID',
    `obtain_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '获得时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_user_medal` (`user_id`, `medal_id`),
    KEY `idx_medal_id` (`medal_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户勋章表';

-- ----------------------------
-- 37. user_level 用户等级表
-- ----------------------------
DROP TABLE IF EXISTS `user_level`;
CREATE TABLE `user_level` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '等级ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `level_name` VARCHAR(20) NOT NULL COMMENT '等级名称: BRONZE-青铜, SILVER-白银, GOLD-黄金, PLATINUM-铂金, DIAMOND-钻石',
    `level` INT NOT NULL DEFAULT 1 COMMENT '等级数值',
    `experience` INT NOT NULL DEFAULT 0 COMMENT '当前经验值',
    `next_level_experience` INT NOT NULL DEFAULT 100 COMMENT '下一级所需经验值',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_user_id` (`user_id`),
    KEY `idx_level` (`level`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户等级表';

-- ----------------------------
-- 38. point_goods 积分商品表
-- ----------------------------
DROP TABLE IF EXISTS `point_goods`;
CREATE TABLE `point_goods` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '商品ID',
    `goods_name` VARCHAR(100) NOT NULL COMMENT '商品名称',
    `goods_image` VARCHAR(500) DEFAULT NULL COMMENT '商品图片URL',
    `description` VARCHAR(500) DEFAULT NULL COMMENT '商品描述',
    `point_price` INT NOT NULL COMMENT '所需积分',
    `stock` INT NOT NULL DEFAULT 0 COMMENT '库存数量',
    `exchanged_count` INT NOT NULL DEFAULT 0 COMMENT '已兑换数量',
    `sort_order` INT NOT NULL DEFAULT 0 COMMENT '排序号',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-下架, 1-上架',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='积分商品表';

-- ----------------------------
-- 39. point_exchange 兑换记录表
-- ----------------------------
DROP TABLE IF EXISTS `point_exchange`;
CREATE TABLE `point_exchange` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '兑换记录ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `goods_id` BIGINT NOT NULL COMMENT '商品ID',
    `point_cost` INT NOT NULL COMMENT '消耗积分',
    `status` TINYINT NOT NULL DEFAULT 0 COMMENT '状态: 0-待发货, 1-已发货, 2-已完成, 3-已取消',
    `shipping_info` VARCHAR(500) DEFAULT NULL COMMENT '发货信息',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_goods_id` (`goods_id`),
    KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='积分兑换记录表';


-- ============================================================================
-- [模块八] 营销活动 (5张表)
-- 表清单: membership, group_buy_activity, group_buy_record, coupon, user_coupon
-- ============================================================================

-- ----------------------------
-- 40. membership 会员套餐表
-- ----------------------------
DROP TABLE IF EXISTS `membership`;
CREATE TABLE `membership` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '套餐ID',
    `membership_name` VARCHAR(100) NOT NULL COMMENT '套餐名称',
    `days` INT NOT NULL COMMENT '有效天数',
    `price` DECIMAL(10,2) NOT NULL COMMENT '价格(元)',
    `original_price` DECIMAL(10,2) DEFAULT NULL COMMENT '原价(元)',
    `discount_rate` DECIMAL(3,2) NOT NULL DEFAULT 1.00 COMMENT '折扣率(如0.8表示八折)',
    `benefits_json` JSON DEFAULT NULL COMMENT '权益JSON(课程折扣/专属内容等)',
    `sort_order` INT NOT NULL DEFAULT 0 COMMENT '排序号',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-下架, 1-上架',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='会员套餐表';

-- ----------------------------
-- 41. group_buy_activity 团购活动表
-- ----------------------------
DROP TABLE IF EXISTS `group_buy_activity`;
CREATE TABLE `group_buy_activity` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '团购活动ID',
    `course_id` BIGINT NOT NULL COMMENT '关联课程ID',
    `group_price` DECIMAL(10,2) NOT NULL COMMENT '团购价格',
    `group_size` INT NOT NULL COMMENT '成团人数',
    `max_groups` INT NOT NULL DEFAULT 0 COMMENT '最大团数(0不限)',
    `current_groups` INT NOT NULL DEFAULT 0 COMMENT '当前成团数',
    `start_time` DATETIME NOT NULL COMMENT '活动开始时间',
    `end_time` DATETIME NOT NULL COMMENT '活动结束时间',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-禁用, 1-启用',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_course_id` (`course_id`),
    KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='团购活动表';

-- ----------------------------
-- 42. group_buy_record 团购记录表
-- ----------------------------
DROP TABLE IF EXISTS `group_buy_record`;
CREATE TABLE `group_buy_record` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '团购记录ID',
    `activity_id` BIGINT NOT NULL COMMENT '团购活动ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `leader_id` BIGINT NOT NULL COMMENT '团长ID',
    `group_no` VARCHAR(32) NOT NULL COMMENT '团号',
    `status` TINYINT NOT NULL DEFAULT 0 COMMENT '状态: 0-拼团中, 1-已成团, 2-已失败, 3-已退款',
    `join_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '参团时间',
    `success_time` DATETIME DEFAULT NULL COMMENT '成团时间',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_activity_id` (`activity_id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_leader_id` (`leader_id`),
    KEY `idx_group_no` (`group_no`),
    KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='团购记录表';

-- ----------------------------
-- 43. coupon 优惠券表
-- ----------------------------
DROP TABLE IF EXISTS `coupon`;
CREATE TABLE `coupon` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '优惠券ID',
    `coupon_name` VARCHAR(100) NOT NULL COMMENT '优惠券名称',
    `coupon_type` TINYINT NOT NULL COMMENT '类型: 1-满减, 2-折扣, 3-兑换',
    `face_value` DECIMAL(10,2) NOT NULL COMMENT '面值(满减为金额,折扣为折扣率如0.8)',
    `min_amount` DECIMAL(10,2) NOT NULL DEFAULT 0.00 COMMENT '最低消费金额',
    `total_count` INT NOT NULL DEFAULT 0 COMMENT '发放总量(0不限)',
    `used_count` INT NOT NULL DEFAULT 0 COMMENT '已使用数量',
    `start_time` DATETIME NOT NULL COMMENT '生效时间',
    `end_time` DATETIME NOT NULL COMMENT '过期时间',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-禁用, 1-启用',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_coupon_type` (`coupon_type`),
    KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='优惠券表';

-- ----------------------------
-- 44. user_coupon 用户优惠券表
-- ----------------------------
DROP TABLE IF EXISTS `user_coupon`;
CREATE TABLE `user_coupon` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '主键ID',
    `user_id` BIGINT NOT NULL COMMENT '用户ID',
    `coupon_id` BIGINT NOT NULL COMMENT '优惠券ID',
    `status` TINYINT NOT NULL DEFAULT 0 COMMENT '状态: 0-未使用, 1-已使用, 2-已过期',
    `use_time` DATETIME DEFAULT NULL COMMENT '使用时间',
    `order_id` BIGINT DEFAULT NULL COMMENT '关联订单ID',
    `expire_time` DATETIME NOT NULL COMMENT '过期时间',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_user_id` (`user_id`),
    KEY `idx_coupon_id` (`coupon_id`),
    KEY `idx_status` (`status`),
    KEY `idx_user_status` (`user_id`, `status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='用户优惠券表';


-- ============================================================================
-- [模块九] 班级管理 (4张表)
-- 表清单: teach_class, class_student, class_schedule, file_record
-- ============================================================================

-- ----------------------------
-- 45. teach_class 教学班级表
-- ----------------------------
DROP TABLE IF EXISTS `teach_class`;
CREATE TABLE `teach_class` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '班级ID',
    `class_name` VARCHAR(100) NOT NULL COMMENT '班级名称',
    `teacher_id` BIGINT NOT NULL COMMENT '教师ID',
    `course_id` BIGINT NOT NULL COMMENT '课程ID',
    `description` VARCHAR(500) DEFAULT NULL COMMENT '班级描述',
    `max_students` INT NOT NULL DEFAULT 50 COMMENT '最大人数',
    `current_students` INT NOT NULL DEFAULT 0 COMMENT '当前人数',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-禁用, 1-启用',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_teacher_id` (`teacher_id`),
    KEY `idx_course_id` (`course_id`),
    KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='教学班级表';

-- ----------------------------
-- 46. class_student 班级学员表
-- ----------------------------
DROP TABLE IF EXISTS `class_student`;
CREATE TABLE `class_student` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '主键ID',
    `class_id` BIGINT NOT NULL COMMENT '班级ID',
    `user_id` BIGINT NOT NULL COMMENT '学员ID',
    `join_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '加入时间',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-已退出, 1-在读',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_class_user` (`class_id`, `user_id`),
    KEY `idx_user_id` (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='班级学员关联表';

-- ----------------------------
-- 47. class_schedule 排课表
-- ----------------------------
DROP TABLE IF EXISTS `class_schedule`;
CREATE TABLE `class_schedule` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '排课ID',
    `class_id` BIGINT NOT NULL COMMENT '班级ID',
    `teacher_id` BIGINT NOT NULL COMMENT '教师ID',
    `course_id` BIGINT NOT NULL COMMENT '课程ID',
    `schedule_date` DATE NOT NULL COMMENT '排课日期',
    `start_time` TIME NOT NULL COMMENT '开始时间',
    `end_time` TIME NOT NULL COMMENT '结束时间',
    `classroom` VARCHAR(100) DEFAULT NULL COMMENT '教室/会议室',
    `topic` VARCHAR(200) DEFAULT NULL COMMENT '课程主题',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态: 0-取消, 1-正常',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `update_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
    PRIMARY KEY (`id`),
    KEY `idx_class_id` (`class_id`),
    KEY `idx_teacher_id` (`teacher_id`),
    KEY `idx_schedule_date` (`schedule_date`),
    KEY `idx_class_date` (`class_id`, `schedule_date`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='排课表';

-- ----------------------------
-- 48. file_record 文件记录表
-- ----------------------------
DROP TABLE IF EXISTS `file_record`;
CREATE TABLE `file_record` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '文件ID',
    `file_name` VARCHAR(255) NOT NULL COMMENT '文件名',
    `file_path` VARCHAR(500) NOT NULL COMMENT 'MinIO存储路径',
    `file_size` BIGINT NOT NULL DEFAULT 0 COMMENT '文件大小(字节)',
    `file_type` VARCHAR(50) DEFAULT NULL COMMENT '文件MIME类型',
    `business_type` VARCHAR(30) DEFAULT NULL COMMENT '业务类型: COURSE_COVER-课程封面, VIDEO-视频, AVATAR-头像, ATTACHMENT-附件',
    `business_id` BIGINT DEFAULT NULL COMMENT '关联业务ID',
    `uploader_id` BIGINT NOT NULL COMMENT '上传者ID',
    `deleted` TINYINT NOT NULL DEFAULT 0 COMMENT '逻辑删除: 0-未删除, 1-已删除',
    `create_time` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    KEY `idx_business` (`business_type`, `business_id`),
    KEY `idx_uploader_id` (`uploader_id`),
    KEY `idx_file_type` (`file_type`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='文件记录表';


