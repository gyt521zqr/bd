-- 课程1: Python入门
INSERT INTO `course_info` (`id`, `title`, `cover`, `description`, `teacher_id`, `language_type`, `difficulty`, `min_age`, `max_age`, `price`, `original_price`, `status`, `trial_chapter_count`, `total_chapters`, `total_duration`, `student_count`) VALUES
(1, 'Python编程入门 - 从零开始学编程', '/uploads/course/python-intro.jpg', '本课程专为8-14岁青少年设计，通过趣味案例和互动练习，带领学生从零基础掌握Python编程。课程涵盖变量、数据类型、条件判断、循环、函数、列表等核心概念，每节课配有动手练习项目。', 2, 'PYTHON', 1, 8, 14, 199.00, 299.00, 1, 3, 24, 57600, 156);

-- 课程2: Scratch启蒙
INSERT INTO `course_info` (`id`, `title`, `cover`, `description`, `teacher_id`, `language_type`, `difficulty`, `min_age`, `max_age`, `price`, `original_price`, `status`, `trial_chapter_count`, `total_chapters`, `total_duration`, `student_count`) VALUES
(2, 'Scratch趣味编程启蒙 - 积木式学编程', '/uploads/course/scratch-start.jpg', '适合5-10岁小朋友的编程启蒙课程，使用Scratch 3.0积木式编程环境，通过制作动画、游戏和互动故事，培养孩子的逻辑思维和创造力。无需任何编程基础，让孩子在玩乐中爱上编程。', 2, 'SCRATCH3', 1, 5, 10, 149.00, 199.00, 1, 2, 18, 43200, 328);

