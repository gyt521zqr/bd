-- ============================================================================
-- 初始化示例练习题 (3条)
-- ============================================================================

-- 题目1: Python - Hello World
INSERT INTO `practice_question` (`id`, `title`, `description`, `language`, `difficulty`, `time_limit`, `memory_limit`, `template_code`, `tags`, `submit_count`, `accept_count`, `accept_rate`, `status`) VALUES
(1, 'Hello World', '请编写一个Python程序，在控制台输出 \"Hello, World!\"。\n\n要求：\n1. 使用print函数输出\n2. 输出内容必须完全匹配（包括标点符号）', 'PYTHON', 1, 1000, 128, '# 请在下方编写你的代码\nprint("Hello, World!")', '入门,输出,基础', 520, 498, 95.77, 1);

-- 题目1的测试用例
INSERT INTO `test_case` (`question_id`, `input_data`, `expected_output`, `is_sample`, `score`, `sort_order`) VALUES
(1, '', 'Hello, World!\n', 1, 100.00, 1);

-- 题目2: Python - 两数之和
INSERT INTO `practice_question` (`id`, `title`, `description`, `language`, `difficulty`, `time_limit`, `memory_limit`, `template_code`, `tags`, `submit_count`, `accept_count`, `accept_rate`, `status`) VALUES
(2, '两数之和', '给定两个整数a和b，请计算它们的和并输出结果。\n\n输入格式：\n一行，包含两个用空格分隔的整数a和b（-10000 <= a, b <= 10000）\n\n输出格式：\n一行，输出a+b的结果', 'PYTHON', 1, 1000, 128, '# 请在下方编写你的代码\na, b = map(int, input().split())\nprint(a + b)', '入门,输入输出,基础运算', 380, 345, 90.79, 1);

-- 题目2的测试用例
INSERT INTO `test_case` (`question_id`, `input_data`, `expected_output`, `is_sample`, `score`, `sort_order`) VALUES
(2, '1 2', '3\n', 1, 25.00, 1),
(2, '10 20', '30\n', 0, 25.00, 2),
(2, '-5 8', '3\n', 0, 25.00, 3),
(2, '0 0', '0\n', 0, 25.00, 4);

-- 题目3: Scratch - 制作小猫走路动画
INSERT INTO `practice_question` (`id`, `title`, `description`, `language`, `difficulty`, `time_limit`, `memory_limit`, `template_code`, `tags`, `submit_count`, `accept_count`, `accept_rate`, `status`) VALUES
(3, '制作小猫走路动画', '使用Scratch制作一个小猫走路的动画。\n\n要求：\n1. 点击绿旗后，小猫从舞台左侧走到右侧\n2. 小猫在移动过程中要有走路的造型切换效果\n3. 走到舞台右侧后停止\n4. 动画流畅自然', 'SCRATCH3', 1, 5000, 256, NULL, 'Scratch,动画,入门,角色', 210, 185, 88.10, 1);

-- 题目3的测试用例（Scratch题目测试用例为评分标准）
INSERT INTO `test_case` (`question_id`, `input_data`, `expected_output`, `is_sample`, `score`, `sort_order`) VALUES
(3, '{"check_type": "has_green_flag"}', '{"pass": true}', 1, 25.00, 1),
(3, '{"check_type": "has_move_blocks"}', '{"pass": true}', 1, 25.00, 2),
(3, '{"check_type": "has_costume_change"}', '{"pass": true}', 0, 25.00, 3),
(3, '{"check_type": "has_stop_condition"}', '{"pass": true}', 0, 25.00, 4);

