(2, 1, 1, '1.1 Python是什么', '了解Python的历史和应用领域', 1, 1),
(3, 1, 1, '1.2 安装Python环境', '手把手教你安装Python和编辑器', 2, 1),
(4, 1, 1, '1.3 第一个Python程序', '编写并运行Hello World', 3, 0),
(5, 1, 0, '第二章 变量与数据类型', '学习Python中的基本数据类型', 2, 0),
(6, 1, 5, '2.1 变量的使用', '如何定义和使用变量', 1, 0),
(7, 1, 5, '2.2 数字与字符串', '整数、浮点数和字符串操作', 2, 0);

