# ============================================================
# 生产环境变量配置
# ============================================================
# 部署说明：
# 1. 将 VITE_APP_BASE_URL 替换为你的实际域名
# 2. VITE_APP_BASE_API 保持 /api，由 Nginx 反向代理到后端服务
# 3. 后端服务地址在 Nginx 配置中指定，不暴露在前端代码中
# 4. 构建命令：npm run build（输出到 dist/ 目录）
# 5. 部署：将 dist/ 目录内容部署到 Web 服务器静态资源目录
#
# Nginx 配置示例：
#   server {
#     listen 443 ssl http2;
#     server_name www.magao.com;
#     root /usr/share/nginx/html;
#     index index.html;
#
#     # 前端静态资源
#     location / {
#       try_files $uri $uri/ /index.html;
#     }
#
#     # API 反向代理到后端
#     location /api/ {
#       proxy_pass http://backend-server:8080/api/;
#       proxy_set_header Host $host;
#       proxy_set_header X-Real-IP $remote_addr;
#       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#       proxy_set_header X-Forwarded-Proto $scheme;
#     }
#
#     # Scratch 资产代理（可选，如需本地化）
#     location /scratch-assets/ {
#       proxy_pass https://cdn.assets.scratch.mit.edu/;
#     }
#   }
# ============================================================

VITE_APP_TITLE=码高少儿编程教育平台
VITE_APP_BASE_API=/api
# 请替换为你的实际域名（影响 SEO、分享链接等）
VITE_APP_BASE_URL=https://www.magao.com
